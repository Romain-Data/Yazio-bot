YAZIO_EMAIL=your_email_yazio@example.com
YAZIO_PASSWORD=your_password_yazio
MAMMOUTH_API_KEY=your_mammouth_api_key

# Options de modèles pour Mammouth AI
# Modèle plus économique pour les requêtes textuelles simples (ex: gemini-2.5-flash-lite, qwen3.5-9b, etc.)
MAMMOUTH_TEXT_MODEL_ID=gemini-2.5-flash-lite
# Modèle plus robuste pour l'analyse d'image (ex: gemini-2.5-flash, qwen3.5-vl-9b, etc.)
MAMMOUTH_IMAGE_MODEL_ID=gemini-2.5-flash
